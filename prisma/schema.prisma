generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String             @id @default(cuid())
  email        String             @unique
  passwordHash String?
  name         String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  words        Word[]
  transcripts  TranscriptUpload[]
  progress     ReviewProgress[]
}

model Word {
  id               String   @id @default(cuid())
  userId           String
  text             String
  lemma            String?
  definitionData   Json?
  status           String   // "known" | "learned"
  firstSeenContext String?
  frequency        Int?
  addedAt          DateTime @default(now())

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, text])
  @@index([userId, lemma])
  @@index([userId, status])
}

model TranscriptUpload {
  id              String            @id @default(cuid())
  userId          String?
  title           String
  rawText         String
  parsedData      Json?             // cached ParseResult
  uploadedAt      DateTime          @default(now())
  wordCount       Int
  uniqueWordCount Int

  user            User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  progress        ReviewProgress[]

  @@index([userId])
}

model ReviewProgress {
  id           String           @id @default(cuid())
  userId       String
  transcriptId String
  currentIndex Int              @default(0)
  completed    Boolean          @default(false)
  updatedAt    DateTime         @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transcript   TranscriptUpload @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@unique([userId, transcriptId])
}
